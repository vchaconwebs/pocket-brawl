{
  "rules": {
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "parties": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('leader').val() === auth.uid || !newData.exists() && data.child('members').child(auth.uid).exists())",
        "leader": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()"
        },
        "state": {
          ".write": "auth != null && data.parent().child('leader').val() === auth.uid"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('leader').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "rematch": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()"
        }
      }
    },
    "mm": {
      "$mode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matches": {
      "$mid": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists())"
      }
    },
    "signal": {
      "$mid": {
        ".write": "auth != null && !newData.exists()",
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          "$from": {
            ".write": "auth != null && auth.uid === $from",
            ".validate": "newData.hasChildren() || newData.isString()"
          }
        }
      }
    },
    "stats": {
      ".read": "auth != null && auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3'",
      "$day": {
        ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
        "$k": {
          ".write": "$k.matches(/^(visits|matches|players|guests|signups|relay)$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "modes": {
          "$m": {
            ".write": "$m.matches(/^(gems|showdown|duo|heist|ball|zone|brawl|knockout)$/)",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "src": {
          "$s": {
            ".write": "$s.matches(/^(directo|tiktok|itch|minijuegos|google|youtube|instagram|x|reddit|facebook|otros)$/)",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "fs": {
          "$k": {
            ".write": "$k.matches(/^(r|w)$/)",
            ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 2000"
          }
        },
        "fsr": {
          "$k": {
            ".write": "$k.matches(/^(ranking|nube|perfil|jugadores|chatclan|clanes|amistad|nombres|regalos|otros)$/)",
            ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 2000"
          }
        },
        "fsw": {
          "$k": {
            ".write": "$k.matches(/^(ranking|nube|perfil|jugadores|chatclan|clanes|amistad|nombres|regalos|otros)$/)",
            ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 2000"
          }
        },
        "dl": {
          "$k": {
            ".write": "$k.matches(/^(relay|chat|online)$/)",
            ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100000"
          }
        },
        "peak": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 50"
        },
        "online": {
          ".read": true,
          "$slot": {
            ".write": "!data.exists()",
            ".validate": "$slot.matches(/^[0-9]{1,3}$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000"
          }
        }
      }
    },
    "statsSeen": {
      "$day": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === true"
        }
      }
    },
    "online": {
      ".read": true,
      "$sid": {
        ".write": "$sid.matches(/^[a-z0-9]{12}$/)",
        ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2) || newData.isString() && newData.val().matches(/^(m|[ps]:(gems|showdown|duo|heist|ball|zone|brawl|knockout))$/)"
      }
    },
    "onlineSum": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['n', 't', 'by']) && newData.child('n').isNumber() && newData.child('n').val() >= 0 && newData.child('n').val() <= 100000 && newData.child('t').val() === now && newData.child('by').isString() && newData.child('by').val().matches(/^[a-z0-9]{12}$/)",
      "n": { ".validate": true },
      "t": { ".validate": true },
      "by": { ".validate": true },
      "m": {
        "$m": {
          ".validate": "$m.matches(/^(gems|showdown|duo|heist|ball|zone|brawl|knockout)$/) && newData.isString() && newData.val().matches(/^[0-9]{1,5},[0-9]{1,5}$/)"
        }
      },
      "$other": { ".validate": false }
    },
    "statsPeak": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isNumber() && newData.child('n').val() > (data.exists() ? data.child('n').val() : 0) && newData.child('n').val() <= (data.exists() ? data.child('n').val() : 0) + 50 && newData.child('t').isNumber()"
    },
    "feedback": {
      ".read": "auth != null && (auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3' || auth.uid === 'JEs9NfqgO6OYw7UKCyDSsqRnk0S2')",
      "$id": {
        ".write": "auth != null && (!data.exists() || (auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3' || auth.uid === 'JEs9NfqgO6OYw7UKCyDSsqRnk0S2'))",
        ".validate": "!newData.exists() || newData.hasChildren(['kind', 'text', 't']) && newData.child('text').isString() && newData.child('text').val().length <= 600 && (newData.child('kind').val() === 'bug' || newData.child('kind').val() === 'idea')"
      }
    },
    "chat": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "auth != null && (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && !root.child('chatBan/' + auth.uid).exists() && newData.parent().parent().child('chatLast/' + auth.uid).val() === now || data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3' || data.child('t').val() < now - 86400000))",
        ".validate": "!newData.exists() || newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('t').val() === now && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 120 && (!newData.child('av').exists() || newData.child('av').isString() && newData.child('av').val().length <= 16)",
        "uid": {
          ".validate": "true"
        },
        "name": {
          ".validate": "true"
        },
        "text": {
          ".validate": "true"
        },
        "t": {
          ".validate": "true"
        },
        "av": {
          ".validate": "true"
        },
        "$other": {
          ".validate": "false"
        },
        "au": {
          ".validate": "newData.isString() && newData.val().length <= 30 && newData.val() === $id"
        },
        "dur": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
        }
      }
    },
    "chatLast": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || now - data.val() >= 2500)"
      }
    },
    "chatBan": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3')",
        ".write": "auth != null && auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3'"
      }
    },
    "partyChat": {
      "$code": {
        ".read": "auth != null && root.child('parties/' + $code + '/members/' + auth.uid).exists()",
        ".indexOn": [
          "t"
        ],
        ".write": "auth != null && !newData.exists() && (!root.child('parties/' + $code).exists() || root.child('parties/' + $code + '/members/' + auth.uid).exists())",
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('parties/' + $code + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('t').val() === now && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 120 && (!newData.child('av').exists() || newData.child('av').isString() && newData.child('av').val().length <= 16)",
          "uid": {
            ".validate": "true"
          },
          "name": {
            ".validate": "true"
          },
          "text": {
            ".validate": "true"
          },
          "t": {
            ".validate": "true"
          },
          "av": {
            ".validate": "true"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "chatAudio": {
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('chat/' + $id + '/uid').val() === auth.uid || data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || auth.uid === 'ULFnTGBapaaIUhxmHKgCh9TIm6G3' || data.child('t').val() < now - 3600000))",
        ".validate": "!newData.exists() || newData.hasChildren(['uid', 'd', 't']) && newData.child('t').val() === now && newData.child('d').isString() && newData.child('d').val().length <= 60000 && (!newData.child('m').exists() || newData.child('m').isString() && newData.child('m').val().length <= 40)",
        "uid": {
          ".validate": "true"
        },
        "d": {
          ".validate": "true"
        },
        "m": {
          ".validate": "true"
        },
        "t": {
          ".validate": "true"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "relay": {
      "$mid": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          ".write": "auth != null && auth.uid === $to && !newData.exists()",
          "$id": {
            ".write": "auth != null && (!data.exists() && newData.child('f').val() === auth.uid || auth.uid === $to && !newData.exists())",
            ".validate": "!newData.exists() || newData.hasChildren(['f', 'd']) && newData.child('d').isString() && newData.child('d').val().length <= 40000"
          }
        }
      }
    }
  }
}
